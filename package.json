{
  "name": "@kriper0nind/wg-utils",
  "version": "2.0.0",
  "description": "Type-safe WireGuard configuration, peer, key, and interface utilities",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "wireguard",
    "vpn",
    "security",
    "tunnel",
    "wg",
    "wg-quick",
    "iptables"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsavelyev-man/wg.git"
  },
  "homepage": "https://wg-mu.vercel.app",
  "author": "dsavelyev-man",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check",
    "dev": "tsx watch src/index.ts",
    "release": "release-it"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "release-it": "^19.0.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "packageManager": "npm@12.0.2",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
